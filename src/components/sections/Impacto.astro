---
import impacto from "../../content/data/impacto.json";
---

<section id="impacto" class="impact-section">
  <div class="container">
    <div class="impact-head" data-reveal="fade-up">
      <p class="impact-eyebrow">Impacto medible</p>
      <h2 class="impact-title">Resultados que pueden mostrarse.</h2>
      <p class="impact-text">
        Sembralas convierte el trabajo ambiental en evidencia concreta: jornadas,
        participación y restauración documentada.
      </p>
    </div>

    <div class="impact-grid">
      {
        impacto.map((item, index) => (
          <article
            class="impact-card"
            data-reveal="fade-up"
            style={`--motion-delay: ${index * 80}ms`}
          >
            <p
              class="impact-value"
              aria-label={`${item.value.toLocaleString("es-CO")}${item.suffix}`}
            >
              <span class="impact-number" data-count={item.value} aria-hidden="true">
                {item.value.toLocaleString("es-CO")}
              </span>
              <span class="impact-suffix" aria-hidden="true">
                {item.suffix}
              </span>
            </p>
            <p class="impact-label">{item.label}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
