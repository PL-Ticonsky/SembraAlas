---
import { Picture } from "astro:assets";
import { journeyImages, type JourneyImageKey } from "../../assets/images";
import jornadas from "../../content/data/jornadas.json";

const responsiveWidths = [320, 480, 720, 960, 1200];
const responsiveSizes =
  "(max-width: 767px) calc((100vw - 2.5rem) * 0.91), (max-width: 900px) calc(100vw - 2.5rem), 600px";
---

<section id="jornadas" class="journeys-section">
  <div class="container">
    <div class="journeys-head" data-reveal="fade-up">
      <p class="journeys-eyebrow">Jornadas destacadas</p>
      <h2 id="jornadas-title" class="journeys-title">
        Cada intervención deja un registro concreto.
      </h2>
      <p class="journeys-text">
        Sembralas desarrolla jornadas documentadas que combinan restauración,
        participación y seguimiento del proceso en territorio.
      </p>
    </div>

    <div
      class="carousel journeys-carousel"
      data-carousel
      role="region"
      aria-roledescription="carrusel"
      aria-labelledby="jornadas-title"
    >
      <div
        class="journeys-list"
        data-carousel-track
        role="group"
        aria-label="Jornadas destacadas"
      >
        {
          jornadas.map((jornada, index) => (
            <article
              class={`journey-item ${index % 2 !== 0 ? "journey-item--reverse" : ""}`}
              data-carousel-slide
              role="group"
              aria-roledescription="diapositiva"
              aria-label={`Jornada ${index + 1} de ${jornadas.length}`}
            >
              <div
                class="journey-media"
                data-reveal="media"
                data-direction={index % 2 !== 0 ? "right" : "left"}
              >
                <Picture
                  src={journeyImages[jornada.image as JourneyImageKey]}
                  formats={["avif", "webp"]}
                  fallbackFormat="jpg"
                  widths={responsiveWidths}
                  sizes={responsiveSizes}
                  width={1200}
                  quality={68}
                  alt={jornada.imageAlt}
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div
                class="journey-body"
                data-reveal="fade-up"
                data-direction={index % 2 !== 0 ? "left" : "right"}
                style="--motion-delay: 80ms"
              >
                <div class="journey-meta">
                  <span>{jornada.date}</span>
                  <span>{jornada.location}</span>
                </div>

                <h3 class="journey-title">{jornada.title}</h3>

                <p class="journey-description">{jornada.description}</p>

                <ul class="journey-stats">
                  {jornada.stats.map((stat) => (
                    <li>{stat}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <div
        class="carousel-controls"
        data-carousel-controls
        role="group"
        aria-label="Controles de Jornadas destacadas"
      >
        <button
          class="carousel-arrow"
          type="button"
          data-carousel-prev
          aria-label="Ver jornada anterior"
          disabled
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </button>

        <div class="carousel-position">
          <div class="carousel-dots" role="group" aria-label="Elegir jornada">
            {
              jornadas.map((_, index) => (
                <button
                  class="carousel-dot"
                  type="button"
                  data-carousel-dot
                  aria-label={`Ir a la jornada ${index + 1} de ${jornadas.length}`}
                  aria-current={index === 0 ? "true" : undefined}
                >
                  <span class="sr-only">Jornada {index + 1}</span>
                </button>
              ))
            }
          </div>
          <span class="carousel-status" data-carousel-status>
            1 de {jornadas.length}
          </span>
          <span class="sr-only" data-carousel-live aria-live="polite" aria-atomic="true"
          ></span>
        </div>

        <button
          class="carousel-arrow"
          type="button"
          data-carousel-next
          aria-label="Ver jornada siguiente"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>
