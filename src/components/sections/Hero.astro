---
import { Picture } from "astro:assets";
import { heroImage } from "../../assets/images";
import Button from "../ui/Button.astro";
---

<section id="hero" class="relative">
  <div class="hero-shell">
    <div class="hero-sticky">
      <Picture
        src={heroImage}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        widths={[640, 960, 1280, 1600, 1920]}
        sizes="100vw"
        width={1920}
        quality={70}
        alt=""
        priority
        pictureAttributes={{ id: "heroBg", class: "hero-bg", "aria-hidden": "true" }}
      />

      <div class="container hero-content">
        <div class="max-w-[70ch]">
          <p
            class="text-sm tracking-[0.2em] uppercase opacity-80"
            data-hero-reveal
            style="--motion-delay: 80ms"
          >
            Reforestación con respaldo académico
          </p>

          <div class="hero-title-mask">
            <h1
              class="text-5xl md:text-6xl mt-4"
              data-hero-reveal
              style="--motion-delay: 150ms"
            >
              Sembrar hoy. Respirar mañana.
            </h1>
          </div>

          <p
            class="mt-6 max-w-[60ch] text-lg opacity-90"
            data-hero-reveal
            style="--motion-delay: 230ms"
          >
            Proyecto real, medible y documentado para restaurar ecosistemas con impacto
            verificable.
          </p>

          <div
            class="mt-8 flex flex-wrap gap-4"
            data-hero-reveal
            style="--motion-delay: 310ms"
          >
            <Button href="#historia">Conoce el proyecto</Button>
            <Button href="#apoyar" variant="secondary">Apoya la reforestación</Button>
          </div>
        </div>
      </div>

      <a href="#historia" class="hero-scroll" aria-label="Ir a Historia">
        <span>Scroll</span>
        <i></i>
      </a>
    </div>
  </div>
</section>
