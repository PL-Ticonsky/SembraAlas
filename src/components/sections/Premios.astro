---
import premios from "../../content/data/premios.json";
---

<section id="premios" class="awards-section">
  <div class="container">
    <div class="awards-head" data-reveal="fade-up">
      <p class="awards-eyebrow">Reconocimiento</p>
      <h2 id="premios-title" class="awards-title">
        El proyecto también ha sido reconocido.
      </h2>

      <p class="awards-text">
        Sembralas ha sido presentado en espacios académicos y de innovación ambiental
        donde su enfoque de restauración documentada ha recibido reconocimiento
        institucional.
      </p>
    </div>

    <div
      class="carousel awards-carousel"
      data-carousel
      role="region"
      aria-roledescription="carrusel"
      aria-labelledby="premios-title"
    >
      <div
        class="awards-list"
        data-carousel-track
        role="group"
        aria-label="Reconocimientos"
      >
        {
          premios.map((award, index) => (
            <article
              class="award-item"
              data-reveal="fade-up"
              data-carousel-slide
              role="group"
              aria-roledescription="diapositiva"
              aria-label={`Reconocimiento ${index + 1} de ${premios.length}`}
              style={`--motion-delay: ${index * 80}ms`}
            >
              <div class="award-meta">
                <span class="award-org">{award.organization}</span>
                <span class="award-year">{award.year}</span>
              </div>

              <h3 class="award-title">{award.title}</h3>

              <p class="award-description">{award.description}</p>
            </article>
          ))
        }
      </div>

      <div
        class="carousel-controls"
        data-carousel-controls
        role="group"
        aria-label="Controles de Reconocimientos"
      >
        <button
          class="carousel-arrow"
          type="button"
          data-carousel-prev
          aria-label="Ver reconocimiento anterior"
          disabled
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </button>

        <div class="carousel-position">
          <div class="carousel-dots" role="group" aria-label="Elegir reconocimiento">
            {
              premios.map((_, index) => (
                <button
                  class="carousel-dot"
                  type="button"
                  data-carousel-dot
                  aria-label={`Ir al reconocimiento ${index + 1} de ${premios.length}`}
                  aria-current={index === 0 ? "true" : undefined}
                >
                  <span class="sr-only">Reconocimiento {index + 1}</span>
                </button>
              ))
            }
          </div>
          <span class="carousel-status" data-carousel-status>
            1 de {premios.length}
          </span>
          <span class="sr-only" data-carousel-live aria-live="polite" aria-atomic="true"
          ></span>
        </div>

        <button
          class="carousel-arrow"
          type="button"
          data-carousel-next
          aria-label="Ver reconocimiento siguiente"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>
