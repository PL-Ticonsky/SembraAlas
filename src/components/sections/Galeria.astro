---
import { Picture } from "astro:assets";
import { galleryImages, type GalleryImageKey } from "../../assets/images";
import galeria from "../../content/data/galeria.json";

const cardClasses = [
  "gallery-card gallery-card--hero",
  "gallery-card gallery-card--tall",
  "gallery-card gallery-card--small",
  "gallery-card gallery-card--small",
  "gallery-card gallery-card--wide",
];

const mobileSlideSize = "calc((100vw - 2.5rem) * 0.91)";

const imageConfig = [
  {
    widths: [480, 720, 960, 1200, 1600],
    sizes: `(max-width: 767px) ${mobileSlideSize}, (max-width: 1024px) calc(100vw - 2.5rem), 510px`,
  },
  {
    widths: [320, 480, 640, 800],
    sizes: `(max-width: 767px) ${mobileSlideSize}, (max-width: 1024px) calc(50vw - 1.75rem), 300px`,
  },
  {
    widths: [320, 480, 640, 800],
    sizes: `(max-width: 767px) ${mobileSlideSize}, (max-width: 1024px) calc(50vw - 1.75rem), 300px`,
  },
  {
    widths: [320, 480, 640, 800],
    sizes: `(max-width: 767px) ${mobileSlideSize}, (max-width: 1024px) calc(50vw - 1.75rem), 300px`,
  },
  {
    widths: [480, 640, 960, 1280, 1600, 1920],
    sizes: `(max-width: 767px) ${mobileSlideSize}, (max-width: 1160px) calc(100vw - 2.5rem), 1120px`,
  },
] as const;
---

<section id="galeria" class="section">
  <div class="container">
    <div class="gallery-head" data-reveal="fade-up">
      <p class="gallery-eyebrow">Memoria visual</p>
      <h2 id="galeria-title" class="gallery-title">
        La restauración también se documenta.
      </h2>
      <p class="gallery-text">
        Cada jornada deja evidencia real: territorio, participación y trabajo colectivo en
        campo.
      </p>
    </div>

    <div
      class="carousel gallery-carousel"
      data-carousel
      role="region"
      aria-roledescription="carrusel"
      aria-labelledby="galeria-title"
    >
      <div
        class="gallery-editorial"
        data-carousel-track
        role="group"
        aria-label="Memoria visual"
      >
        {
          galeria.map((item, index) => (
            <figure
              class={cardClasses[index]}
              data-reveal="gallery"
              data-carousel-slide
              role="group"
              aria-roledescription="diapositiva"
              aria-label={`Imagen ${index + 1} de ${galeria.length}`}
              style={`--motion-delay: ${index * 90}ms`}
            >
              <Picture
                src={galleryImages[item.image as GalleryImageKey]}
                formats={["avif", "webp"]}
                fallbackFormat="jpg"
                widths={[...imageConfig[index].widths]}
                sizes={imageConfig[index].sizes}
                width={imageConfig[index].widths.at(-1)}
                quality={66}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))
        }
      </div>

      <div
        class="carousel-controls"
        data-carousel-controls
        role="group"
        aria-label="Controles de Memoria visual"
      >
        <button
          class="carousel-arrow"
          type="button"
          data-carousel-prev
          aria-label="Ver imagen anterior"
          disabled
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
        </button>

        <div class="carousel-position">
          <div class="carousel-dots" role="group" aria-label="Elegir imagen">
            {
              galeria.map((_, index) => (
                <button
                  class="carousel-dot"
                  type="button"
                  data-carousel-dot
                  aria-label={`Ir a la imagen ${index + 1} de ${galeria.length}`}
                  aria-current={index === 0 ? "true" : undefined}
                >
                  <span class="sr-only">Imagen {index + 1}</span>
                </button>
              ))
            }
          </div>
          <span class="carousel-status" data-carousel-status>
            1 de {galeria.length}
          </span>
          <span class="sr-only" data-carousel-live aria-live="polite" aria-atomic="true"
          ></span>
        </div>

        <button
          class="carousel-arrow"
          type="button"
          data-carousel-next
          aria-label="Ver imagen siguiente"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>
