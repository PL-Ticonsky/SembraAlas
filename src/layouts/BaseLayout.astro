---
import "../styles/tokens.css";
import "../styles/globals.css";
const { title = "Sembralas" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body id="top">
    <slot />

    <script is:inline>
      (() => {
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        const revealElements = document.querySelectorAll("[data-reveal]");

        if (!reducedMotion.matches && "IntersectionObserver" in window) {
          const numberFormatter = new Intl.NumberFormat("es-CO");
          const animateCounter = (element) => {
            const target = Number(element.dataset.count);
            if (!Number.isFinite(target)) return;

            const startedAt = performance.now();
            const duration = 900;
            element.textContent = "0";

            const update = (now) => {
              const progress = Math.min(1, (now - startedAt) / duration);
              const eased = 1 - Math.pow(1 - progress, 3);
              element.textContent = numberFormatter.format(Math.round(target * eased));

              if (progress < 1) requestAnimationFrame(update);
            };

            requestAnimationFrame(update);
          };

          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;

                entry.target.classList.add("is-visible");
                const counter = entry.target.querySelector("[data-count]");
                if (counter instanceof HTMLElement) animateCounter(counter);
                observer.unobserve(entry.target);
              }
            },
            { threshold: 0.12, rootMargin: "0px 0px -10% 0px" },
          );

          document.documentElement.classList.add("motion-ready");
          revealElements.forEach((element) => observer.observe(element));

          const parallaxQuery = window.matchMedia("(min-width: 768px)");
          const bg = document.getElementById("heroBg");

          if (bg && parallaxQuery.matches) {
            let frameRequested = false;
            let lastOffset = -1;

            const updateParallax = () => {
              const y = window.scrollY || 0;
              const offset = Math.round(Math.min(18, y * 0.04) * 10) / 10;

              if (offset !== lastOffset) {
                bg.style.transform = `translate3d(0, ${offset}px, 0) scale(1.04)`;
                lastOffset = offset;
              }

              frameRequested = false;
            };

            const onScroll = () => {
              if (frameRequested) return;
              frameRequested = true;
              requestAnimationFrame(updateParallax);
            };

            updateParallax();
            window.addEventListener("scroll", onScroll, { passive: true });
          }
        }

        const mobileCarousel = window.matchMedia("(max-width: 767px)");
        const interactiveSelector =
          "a, button, input, select, textarea, [contenteditable='true']";

        const initializeCarousel = (carousel) => {
          if (!(carousel instanceof HTMLElement)) return;
          if (carousel.dataset.carouselInitialized === "true") return;

          const track = carousel.querySelector("[data-carousel-track]");
          const slides = [...carousel.querySelectorAll("[data-carousel-slide]")];
          const previous = carousel.querySelector("[data-carousel-prev]");
          const next = carousel.querySelector("[data-carousel-next]");
          const dots = [...carousel.querySelectorAll("[data-carousel-dot]")];
          const status = carousel.querySelector("[data-carousel-status]");
          const liveStatus = carousel.querySelector("[data-carousel-live]");

          if (
            !(track instanceof HTMLElement) ||
            !(previous instanceof HTMLButtonElement) ||
            !(next instanceof HTMLButtonElement) ||
            !(status instanceof HTMLElement) ||
            !(liveStatus instanceof HTMLElement) ||
            slides.length < 2 ||
            dots.length !== slides.length
          ) {
            return;
          }

          carousel.dataset.carouselInitialized = "true";
          carousel.classList.add("is-enhanced");

          let activeIndex = 0;
          let slideObserver;
          let scrollFrame = 0;
          let pendingAnnouncement = null;
          const visibility = new Map(slides.map((slide) => [slide, 0]));

          const updateActive = (index) => {
            activeIndex = Math.max(0, Math.min(index, slides.length - 1));
            previous.disabled = activeIndex === 0;
            next.disabled = activeIndex === slides.length - 1;
            status.textContent = `${activeIndex + 1} de ${slides.length}`;

            dots.forEach((dot, dotIndex) => {
              if (dotIndex === activeIndex) {
                dot.setAttribute("aria-current", "true");
              } else {
                dot.removeAttribute("aria-current");
              }
            });

            if (pendingAnnouncement === activeIndex) {
              liveStatus.textContent = `Elemento ${activeIndex + 1} de ${slides.length}`;
              pendingAnnouncement = null;
            }
          };

          const closestSlide = () => {
            const trackLeft = track.getBoundingClientRect().left;
            let closestIndex = 0;
            let closestDistance = Infinity;

            slides.forEach((slide, index) => {
              const distance = Math.abs(slide.getBoundingClientRect().left - trackLeft);
              if (distance < closestDistance) {
                closestDistance = distance;
                closestIndex = index;
              }
            });

            return closestIndex;
          };

          const scrollToSlide = (index) => {
            if (!mobileCarousel.matches) return;

            const targetIndex = Math.max(0, Math.min(index, slides.length - 1));
            const trackRect = track.getBoundingClientRect();
            const slideRect = slides[targetIndex].getBoundingClientRect();
            pendingAnnouncement = targetIndex;

            track.scrollTo({
              left: track.scrollLeft + slideRect.left - trackRect.left,
              behavior: reducedMotion.matches ? "auto" : "smooth",
            });

            if (targetIndex === activeIndex) updateActive(targetIndex);
          };

          const onObservedSlides = (entries) => {
            entries.forEach((entry) =>
              visibility.set(entry.target, entry.intersectionRatio),
            );

            let dominantIndex = closestSlide();
            let dominantRatio = -1;
            slides.forEach((slide, index) => {
              const ratio = visibility.get(slide) || 0;
              if (ratio > dominantRatio) {
                dominantRatio = ratio;
                dominantIndex = index;
              }
            });
            updateActive(dominantIndex);
          };

          const onFallbackScroll = () => {
            if (scrollFrame) return;
            scrollFrame = requestAnimationFrame(() => {
              updateActive(closestSlide());
              scrollFrame = 0;
            });
          };

          const enableMobileMode = () => {
            track.tabIndex = 0;
            updateActive(closestSlide());

            if ("IntersectionObserver" in window) {
              slideObserver = new IntersectionObserver(onObservedSlides, {
                root: track,
                threshold: [0, 0.25, 0.5, 0.75, 0.9, 1],
              });
              slides.forEach((slide) => slideObserver.observe(slide));
            } else {
              track.addEventListener("scroll", onFallbackScroll, { passive: true });
            }
          };

          const disableMobileMode = () => {
            slideObserver?.disconnect();
            slideObserver = undefined;
            track.removeEventListener("scroll", onFallbackScroll);
            track.removeAttribute("tabindex");
            track.scrollLeft = 0;
            visibility.forEach((_, slide) => visibility.set(slide, 0));
            pendingAnnouncement = null;
            updateActive(0);
          };

          const syncMode = () => {
            disableMobileMode();
            if (mobileCarousel.matches) requestAnimationFrame(enableMobileMode);
          };

          previous.addEventListener("click", () => scrollToSlide(activeIndex - 1));
          next.addEventListener("click", () => scrollToSlide(activeIndex + 1));
          dots.forEach((dot, index) =>
            dot.addEventListener("click", () => scrollToSlide(index)),
          );

          carousel.addEventListener("keydown", (event) => {
            if (!mobileCarousel.matches || !(event.target instanceof Element)) return;
            if (event.target.closest(interactiveSelector)) return;
            if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;

            event.preventDefault();
            scrollToSlide(activeIndex + (event.key === "ArrowRight" ? 1 : -1));
          });

          mobileCarousel.addEventListener("change", syncMode);
          window.addEventListener("resize", () => {
            if (!mobileCarousel.matches || scrollFrame) return;
            scrollFrame = requestAnimationFrame(() => {
              updateActive(closestSlide());
              scrollFrame = 0;
            });
          });

          syncMode();
        };

        document.querySelectorAll("[data-carousel]").forEach(initializeCarousel);
      })();
    </script>
  </body>
</html>
